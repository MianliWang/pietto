pietto 0.9
mode checked
dialect postgres
encoding utf8

shape CompatibilityRow:
    order: Text not null
    email: Text not null

source Rows: CompatibilityRow is postgres.table("Sales.CompatibilityRows")

table LiteralCompatibility:
    from Rows
    where email == "\\'; --"
    select:
        QuotedText = "O'Reilly"
        EscapedText = "\\'; --"
        Truth = true
        Count = 42
        Ratio = 1.5
        ReservedName = order
