pietto 0.9
mode checked
dialect postgres
encoding utf8

shape MetricRow:
    email: Text | None
    age: Int
    score: Int
    deleted_at: Timestamp | None
    active: Bool

source metrics: MetricRow = postgres.table("analytics.metrics")

table expression_compatibility:
    from metrics
    where (age >= 18 and deleted_at is None) or matches(email, ".+@.+")
    select:
        normalized = lower(trim(email))
        text_length = len(email)
        equal = score == 10
        not_equal = score != 11
        less = score < 12
        less_equal = score <= 13
        greater = score > 8
        greater_equal = score >= 7
        ranged = 1 <= score <= 100
        not_null = email is not None
        positive = +score
        negative = -score
        added = score + 2
        subtracted = score - 2
        multiplied = score * 2
        divided = score / 2
        modulo = score % 2
        conjunction = active and True
        disjunction = active or False
        precedence = score + 2 * 3
        grouped = (score + 2) * 3
