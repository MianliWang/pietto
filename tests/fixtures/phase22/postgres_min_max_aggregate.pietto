shape Order:
    status: Text
    amount: Int
    score: Float
    order_date: Date | None
    created_at: Timestamp

source orders: Order = postgres.table("orders")

table order_extremes:
    from orders
    where status == "paid"
    select:
        smallest_amount = min(amount)
        highest_score = max(score)
        first_order_date = min(orders.order_date)
        latest_created_at = max(orders.created_at)
