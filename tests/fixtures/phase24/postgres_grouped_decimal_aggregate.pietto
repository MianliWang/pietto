shape Order:
    status: Text
    amount: Decimal

source orders: Order = postgres.table("orders")

table decimal_order_stats_by_status:
    from orders
    where status == "paid"
    group by:
        status
    select:
        status
        total_amount = sum(amount)
        average_amount = avg(amount)
        smallest_amount = min(amount)
        largest_amount = max(orders.amount)
