shape Order:
    status: Text
    customer_id: UUID
    region: Text | None

source orders: Order = mysql.table("orders")

table unique_customers_by_status:
    from orders
    where status == "paid"
    group by:
        status
    select:
        status
        unique_customers = count_distinct(customer_id)
        unique_statuses = count_distinct(orders.status)
