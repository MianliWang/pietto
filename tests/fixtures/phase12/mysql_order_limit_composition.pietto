pietto 0.9
mode checked
dialect mysql
encoding utf8

shape User:
    id: Int
    created_at: Int
    email: Text
    active: Bool

source users: User = mysql.table("users")

query recent_active_users:
    from users
    where active == True
    select:
        id
        normalized = lower(email)
    order by:
        created_at desc
        id
    limit 100
