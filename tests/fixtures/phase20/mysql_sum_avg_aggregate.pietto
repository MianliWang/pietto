shape Order:
    status: Text
    amount: Int
    score: Float

source orders: Order = mysql.table("orders")

table paid_order_stats:
    from orders
    where status == "paid"
    select:
        total = count()
        revenue = sum(amount)
        score_total = sum(score)
        average_amount = avg(amount)
        average_score = avg(score)
