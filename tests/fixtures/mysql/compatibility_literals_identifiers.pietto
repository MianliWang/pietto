pietto 0.9
mode checked
dialect mysql
encoding utf8

shape CompatibilityRow:
    order: Text
    email: Text

source Rows: CompatibilityRow = mysql.table("Sales.Compat`ibilityRows")

table LiteralCompatibility:
    from Rows
    where email == "\\'; --"
    select:
        QuotedText = "O'Reilly"
        EscapedText = "\\'; --"
        ControlText = "\b\n\r\t"
        UnicodeText = "你好"
        Nothing = None
        Truth = True
        Falsehood = False
        Count = 42
        Ratio = 1.5
        ReservedName = order
        QualifiedEmail = Rows.email
