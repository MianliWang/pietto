pietto 0.9
mode checked
dialect mysql
encoding utf8

type Email = Text

enum Status:
    active
    inactive

constraint valid_email(value: Text) -> Bool:
    return value is not None

derive normalized_email(value: Text) -> Text:
    return lower(trim(value))

shape User:
    id: UUID
    email: Text
    active: Bool

source users: User = mysql.table("app.users")

table FirstRelation:
    from users
    where active == True
    select:
        id
        email

query SecondRelation:
    from FirstRelation
    select:
        normalized_email = lower(trim(email))
