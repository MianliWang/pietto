shape User:
    id: UUID
    email: Text | None
    email_norm: Text | None
    deleted_at: Timestamp | None

source users: User = postgres.table("public.users")

table active_users:
    from users
    where deleted_at is None
    select:
        id
        email
        email_norm = lower(trim(email))

query active_user_emails:
    from active_users
    select:
        email
        email_norm
