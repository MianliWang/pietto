pietto 0.9
mode checked
dialect postgres
encoding utf8

type UserId = UUID not null
type Percent = Float not null ensure self between 0 and 1

type Username = Text(max = 32, encoding = utf8) not null:
    ensure len(self) >= 3
    ensure matches(self, "^[a-zA-Z0-9_]+$")

enum Status:
    draft
    paid
    shipped
