+def test_compiled_count_distinct_tuple_rejects_a_duplicate_direct_read(tmp_path):
+    """A forged compiled tuple cannot name one direct source occurrence twice."""
+    from dataclasses import replace
+    from pietto._project.project_compiled_schema import (
+        FIELDS,
+        CompiledError,
+        Record,
+        content_pin,
+        encode,
+    )
+
+    original = build(tmp_path, "postgres", "V_aggregate_blocked", "count_distinct_tuple")
+    assert original.status == "VERIFIED" and original.artifact is not None
+    built = build_compiled(original.artifact)
+    aggregate = next(
+        record
+        for record in built.root.description.records
+        if record.address.kind == "aggregate_value"
+        and record.get("function") == "count_distinct_tuple"
+        and len(record.get("arguments")) == 2
+    )
+    first, *_rest = aggregate.get("arguments")
+    values = list(aggregate.values)
+    values[FIELDS[aggregate.address.kind].index("arguments")] = (first, first)
+    forged = Record(aggregate.address, tuple(values))
+    description = replace(
+        built.root.description,
+        members=tuple(
+            (name, tuple(forged if record.address == forged.address else record for record in members))
+            for name, members in built.root.description.members
+        ),
+    )
+    raw = encode(description)
+    with pytest.raises(CompiledError, match="^COMPILED_AGGREGATE_SIGNATURE$"):
+        load_compiled(
+            raw,
+            expected_pin=content_pin(raw),
+            accepted_producer=built.producer,
+            accepted_compatibility=built.compatibility,
+        )
+
