+
+
+def test_mysql_group_test_compiled_function_forgery_is_refused(tmp_path):
+    from pietto._project.project_compiled_schema import FIELDS, CompiledError, Record, content_pin, encode
+
+    item = emission.aggregate_fixture("mysql", "X_aggregate_grouped", "hidden")
+    source = emission.AGGREGATE_HEADER.format(target="mysql") + (
+        "query result:\n    from agg\n    group by:\n        key\n    select:\n"
+        "        n = sum(1 for o in group if o.flag)\n        a = all(o.flag for o in group)\n        b = any(o.label == \"a\" for o in group)\n"
+    )
+    _, outcome = emission.build_case(tmp_path, source, item["contract"], item["policy"])
+    assert outcome.artifact is not None
+    built = build_compiled(outcome.artifact)
+    record = next(item for item in built.root.description.records if item.address.kind == "aggregate_value" and item.get("function") == "group_all")
+    values = list(record.values)
+    values[FIELDS[record.address.kind].index("function")] = "filtered_count"
+    forged = Record(record.address, tuple(values))
+    description = replace(built.root.description, members=tuple((name, tuple(forged if item.address == forged.address else item for item in members)) for name, members in built.root.description.members))
+    raw = encode(description)
+    with pytest.raises(CompiledError, match="^COMPILED_AGGREGATE_"):
+        emit_compiled(load_compiled(raw, expected_pin=content_pin(raw), accepted_producer=built.producer, accepted_compatibility=built.compatibility), ())
