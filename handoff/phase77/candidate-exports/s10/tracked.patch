+    source = emission.AGGREGATE_HEADER.format(target="mysql") + (
+        "query result:\n    from agg\n    group by:\n        key\n    select:\n"
+        "        n = sum(1 for o in group if o.flag)\n"
+        "        a = all(o.flag for o in group)\n"
+        '        b = any(o.label == "a" for o in group)\n'
+    )
