+def test_text_window_default_tokens_keep_their_target_family() -> None:
+    """A pure observation never accepts the other target's Text token."""
+
+    postgres = {
+        "tag": "Text",
+        "storage": {"kind": "pg_text"},
+        "domain": {"kind": "text", "max_characters": 0},
+    }
+    mysql = {
+        "tag": "Text",
+        "storage": {"kind": "my_utf8mb4_text"},
+        "domain": {"kind": "text", "max_characters": 0},
+    }
+    assert pure._window_value_representation(
+        "postgres", {}, postgres, r"E'\351\233\252'", {}
+    ) == ({"kind": "pg_text"}, {"kind": "text", "max_characters": 1})
+    assert pure._window_value_representation(
+        "mysql", {}, mysql, "X'e99baa'", {}
+    ) == ({"kind": "my_utf8mb4_text"}, {"kind": "text", "max_characters": 1})
+    assert pure._window_value_representation("mysql", {}, mysql, "X''", {}) == (
+        {"kind": "my_utf8mb4_text"},
+        {"kind": "text", "max_characters": 0},
+    )
+    assert pure._window_value_representation(
+        "postgres", {}, postgres, "X'e99baa'", {}
+    ) is None
+    assert pure._window_value_representation(
+        "mysql", {}, mysql, r"E'\351\233\252'", {}
+    ) is None
+
