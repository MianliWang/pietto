+def _mysql_window_aggregate_admitted(doc, function, arguments, result) -> bool:
+    """Re-derive MySQL's finite direct aggregate-window carrier subset."""
+
+    count_result = _is_realization(
+        result,
+        "Int",
+        {"kind": "my_bigint"},
+        {"kind": "int_range", "min": "0", "max": str((1 << 63) - 1)},
+    ) and result["nullable"] is False
+    if function == "count" and not arguments:
+        return count_result
+    if function not in {"count", "min", "max"} or len(arguments) != 1:
+        return False
+    (argument,) = arguments
+    if argument["role"] != "value" or argument["read"] is None or argument["literal"] is not None:
+        return False
+    read = doc[argument["read"]]
+    if (
+        read["field"] is None
+        and read["aggregate"] is None
+        or not _source_field_matches_stage(doc, read)
+    ):
+        return False
+    carrier = doc[read["realization"]]
+    if function == "count":
+        return count_result and (
+            _is_key_value(carrier, "mysql") or _is_float(carrier, "mysql")
+        )
+    if carrier["tag"] not in {"Int", "Float", "Decimal", "Timestamp", "Date"}:
+        return False
+    if not (
+        _is_float(carrier, "mysql")
+        if carrier["tag"] == "Float"
+        else _is_key_value(carrier, "mysql")
+    ):
+        return False
+    return (
+        result["tag"] == carrier["tag"]
+        and dict(result["storage"]) == dict(carrier["storage"])
+        and dict(result["domain"]) == dict(carrier["domain"])
+        and result["nullable"] is True
+    )
+
+
