+def test_mysql_direct_aggregate_windows_replay_from_compiled_input(tmp_path):
+    """The admitted direct aggregate-window subset keeps its compiled SQL."""
+    from pietto._project.project_compiled_schema import CompiledError, FIELDS
+    from pietto._project.project_compiled_verification import verify_description
+
+    item = emission.parameterized_fixture(
+        "mysql",
+        "table result:\n    from rows\n    select:\n        id\n"
+        "        n = count() window(order by id)\n"
+        "        low = min(ratio) window(partition by flag order by id)\n"
+        "        high = max(money) window(order by id)\n",
+        protocol=False,
+    )
+    checked, outcome = emission.build_case(
+        tmp_path, item["source"], item["contract"], item["policy"]
+    )
+    assert checked.verified and outcome.status == "VERIFIED", outcome.blockers
+    built = build_compiled(outcome.artifact)
+    candidate = _compare(outcome.artifact, refinement=False, built=built)
+    assert candidate.rendered.sql == outcome.artifact.rendered.sql
+    minimum = next(
+        record
+        for record in built.root.description.records
+        if record.address.kind == "window_value" and record.get("function") == "min"
+    )
+    values = list(minimum.values)
+    values[FIELDS["window_value"].index("function")] = "sum"
+    with pytest.raises(CompiledError, match="^COMPILED_WINDOW_FUNCTION$"):
+        verify_description(
+            _replaced(built.root.description, {minimum.address: tuple(values)})
+        )
+
