+# UUID correction: implementation freedom, not an owner decision
+
+## Established contract
+
+The current result/public-pure contract already names MySQL UUID storage as
+`my_uuid_bytes` with `{"kind": "uuid", "encoding": "standard_bytes"}`.
+The row law explicitly equates PostgreSQL UUID ordering with unsigned
+big-endian MySQL `BINARY(16)` ordering.  The stored public header value is
+already the canonical lower-case UUID text in the typed binding vector.
+
+Therefore the UUID carrier selection does not require a new public contract:
+the supported physical result carrier is `my_uuid_bytes`, and the public
+typed value/wire remains `["UUID", canonical_lower_text]`.  Choosing how the
+private MySQL prepared argument reaches that established carrier is
+`IMPLEMENTATION_FREEDOM`, provided it preserves those facts, NULL, errors,
+and canonical bytes.
+
+## Two exact lowerings the present callers can carry
+
+| Lowering | Prepared SQL | Native argument from the existing public value | Public/bundle impact | Status |
+| --- | --- | --- | --- | --- |
+| strict text slot | `UNHEX(REPLACE(?, '-', ''))` | existing canonical `str(UUID)` from `native_value()` | none; typed vector remains canonical UUID text | viable SQL alternative; raw metadata/type still needs DB proof |
+| selected native bytes | `CAST(? AS BINARY(16))` | `UUID.bytes` (exactly 16 standard-order bytes) | none to the public typed value or binding vector; private MySQL native argument only | smallest selected candidate, pending raw DB proof |
+
+Both give the same standard bytes only when the text path removes exactly the
+four hyphens and the bytes path uses `UUID.bytes`, not `bytes_le`,
+`UUID.int.to_bytes(..., 'little')`, or time-swapping.  Do not retain both
+production paths: select native bytes because the established physical carrier
+is bytes and it avoids a server-side text transformation.
+
+## Exact closure and non-impact claim
+
+- `native_value(tag, value, family)` is the only runtime argument conversion
+  point: specialize only its MySQL/UUID arm from canonical text to
+  `value.bytes`; preserve its PostgreSQL UUID text behavior.
+- `native_arguments()` already preserves one MySQL argument per occurrence,
+  so duplicate UUID reads need no new allocation framework.
+- `anchor_suffix()` / rendering needs a target spelling for
+  `my_uuid_bytes`: `CAST(? AS BINARY(16))`. Its verifier must independently
+  require exactly those bytes.
+- The compiled/pure reader already recognizes `my_uuid_bytes` plus
+  `standard_bytes`. A newly enabled compiled MySQL parameter artifact must
+  carry that existing physical identity; old artifacts do not change.
+- The public compiled/binding scalar is still canonical text. Runtime
+  `UUID.bytes` is derived only after public binding validation, so it changes
+  neither public wire bytes nor stored vector identity.
+
+This is not a proof that Connector/Python parameter metadata or expression
+metadata reports the required BINARY(16) shape. The required direct prepared
+database probe remains the authority for raw SQL bytes, driver parameter
+encoding, prepare/result metadata, warnings, NULL, high-bit UUID, and row
+differential.
+
+The executable [pure_parameter_prep_selfcheck.py](pure_parameter_prep_selfcheck.py)
+checks the exact no-DB transformations below; it does not substitute for that
+probe.
+
*** Add File: /tmp/pietto-p77-s09-qualification/pure_parameter_prep_selfcheck.py
+#!/usr/bin/env python3
+"""No-DB S09 candidate preparation check.
+
+This checks deterministic public-value-to-private-argument preparation only.
+It neither imports Pietto nor opens a driver, so it cannot establish MySQL SQL
+or metadata behavior.
+"""
+
+from datetime import date, datetime, timezone
+from decimal import Decimal, InvalidOperation, localcontext
+from uuid import UUID
+
+I64 = 1 << 63
+
+
+def decimal_fits(value: Decimal, precision: int, scale: int) -> bool:
+    if not value.is_finite() or not 1 <= precision <= 65 or not 0 <= scale <= min(precision, 30):
+        return False
+    with localcontext() as context:
+        context.prec = 66
+        try:
+            exact = value.quantize(Decimal(1).scaleb(-scale))
+        except InvalidOperation:
+            return False
+    return exact == value and len(exact.as_tuple().digits) <= precision
+
+
+def public_text(tag: str, value: object) -> str:
+    if tag == "Decimal" and type(value) is Decimal and value.is_finite():
+        with localcontext() as context:
+            context.prec = 66
+            normalized = value.normalize()
+        return "0" if normalized == 0 else format(normalized, "f")
+    if tag == "Date" and type(value) is date:
+        return value.isoformat()
+    if tag == "Timestamp" and type(value) is datetime and value.tzinfo is None:
+        if datetime(1000, 1, 1) <= value <= datetime(9999, 12, 31, 23, 59, 59, 499999):
+            return value.isoformat(sep=" ", timespec="microseconds")
+    if tag == "UUID" and type(value) is UUID:
+        return str(value)
+    raise ValueError("invalid public typed value")
+
+
+def mysql_anchor(tag: str, decimal: tuple[int, int] | None = None) -> str:
+    if tag == "Decimal" and decimal is not None:
+        precision, scale = decimal
+        if 1 <= precision <= 65 and 0 <= scale <= min(precision, 30):
+            return f"CAST(? AS DECIMAL({precision},{scale}))"
+    if tag == "Date":
+        return "CAST(? AS DATE)"
+    if tag == "Timestamp":
+        return "CAST(? AS DATETIME(6))"
+    if tag == "UUID":
+        return "CAST(? AS BINARY(16))"
+    raise ValueError("unsupported anchor")
+
+
+def mysql_native_argument(tag: str, value: object) -> object:
+    if value is None:
+        return None
+    if tag == "UUID":
+        if type(value) is not UUID:
+            raise ValueError("invalid UUID")
+        return value.bytes
+    return public_text(tag, value)
+
+
+def main() -> None:
+    decimal = Decimal("99999999999999999999999999999999999.999999999999999999999999999999")
+    assert decimal_fits(decimal, 65, 30)
+    assert not decimal_fits(Decimal("1.001"), 3, 2)
+    assert not decimal_fits(Decimal("Infinity"), 3, 2)
+    assert mysql_anchor("Decimal", (65, 30)) == "CAST(? AS DECIMAL(65,30))"
+    assert mysql_anchor("Date") == "CAST(? AS DATE)"
+    assert mysql_anchor("Timestamp") == "CAST(? AS DATETIME(6))"
+
+    stamp = datetime(2026, 11, 8, 1, 2, 3, 4)
+    assert public_text("Timestamp", stamp) == "2026-11-08 01:02:03.000004"
+    try:
+        public_text("Timestamp", stamp.replace(tzinfo=timezone.utc))
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("aware Timestamp accepted")
+
+    value = UUID("00112233-4455-6677-8899-aabbccddeeff")
+    high = UUID("f1223344-5566-7788-99aa-bbccddeeff00")
+    assert mysql_anchor("UUID") == "CAST(? AS BINARY(16))"
+    assert public_text("UUID", value) == "00112233-4455-6677-8899-aabbccddeeff"
+    assert mysql_native_argument("UUID", value) == bytes.fromhex("00112233445566778899aabbccddeeff")
+    assert mysql_native_argument("UUID", high) == bytes.fromhex("f12233445566778899aabbccddeeff00")
+    assert mysql_native_argument("UUID", value) != value.bytes_le
+    assert mysql_native_argument("UUID", None) is None
+
+    # MySQL receives every authored occurrence, while public UUID wire is text.
+    occurrences = (value, high, None, value)
+    assert tuple(mysql_native_argument("UUID", item) for item in occurrences) == (
+        value.bytes,
+        high.bytes,
+        None,
+        value.bytes,
+    )
+    assert [public_text("UUID", item) for item in occurrences if item is not None] == [
+        str(value),
+        str(high),
+        str(value),
+    ]
+
+    hostile = "' OR 1=1 -- ?"
+    assert hostile not in mysql_anchor("UUID")
+    try:
+        mysql_native_argument("UUID", hostile)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("non-UUID injection payload accepted")
+    print("pure parameter preparation self-check: PASS")
+
+
+if __name__ == "__main__":
+    main()
+
